{
  "name": "react-github-ribbons",
  "version": "0.3.0",
  "description": "React component that renders a \"Fork me on GitHub\" ribbon",
  "keywords": [
    "react",
    "github",
    "ribbon",
    "fork-me",
    "component"
  ],
  "license": "MIT",
  "author": "Hidetaka Okamoto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wpkyoto/react-github-ribbons.git"
  },
  "bugs": {
    "url": "https://github.com/wpkyoto/react-github-ribbons/issues"
  },
  "homepage": "https://github.com/wpkyoto/react-github-ribbons#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build && node -e \"require('node:fs').copyFileSync('dist/index.d.ts','dist/index.d.cts')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky",
    "typecheck": "tsc",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "check:exports": "attw --pack .",
    "check:rsc": "node --conditions=react-server --input-type=module -e \"const m = await import('react-github-ribbons'); if (typeof m.default !== 'object' || typeof m.getRibbonImageURL !== 'function') throw new Error('unexpected exports under react-server')\""
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
